# Copy to .env, fill in, then load it -- nothing in the code reads .env by
# itself (no python-dotenv, deliberately: one less dependency). Load it with:
#
#     set -a; source .env; set +a
#
# .env is gitignored. Never commit a filled-in copy.

# --- model layer -----------------------------------------------------------
# OPENAI_API_KEY and OPENAI_BASE_URL are read by the openai SDK itself, not by
# our code -- which is why swapping providers needs no code change at all.

# Groq hosting OpenAI's open-weights model. Both gpt-oss models support
# strict json_schema via constrained decoding, which is what score_one() needs.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_...
OPENAI_MODEL=openai/gpt-oss-120b
PRICE_IN=0.15
PRICE_OUT=0.60

# For OpenAI's own API instead, unset OPENAI_BASE_URL and use:
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-5.2
#   PRICE_IN=1.25
#   PRICE_OUT=10.00

# --- Unify -----------------------------------------------------------------
# Only needed for `agent.py --write`. Dry run is the default and needs nothing.
UNIFY_API_KEY=

# --- switches --------------------------------------------------------------
# Point at a recording and the model call is replaced; every other layer still
# runs for real. Leave empty for live decisions.
APEX_REPLAY=

# Set to 1 and the agent refuses to run at all. The visible off switch.
LEADSCORE_KILL=0
